# Knowledge Base API URL (for MCP server to connect to)
KB_API_URL=http://localhost:8000

# ChromaDB storage path
KB_CHROMADB_PATH=./data/chromadb

# SQLite database path
KB_SQLITE_PATH=./data/knowledge_base.db

# Embedding model name (sentence-transformers compatible)
KB_EMBEDDING_MODEL=BAAI/bge-m3

# API server port
KB_PORT=8000
